{
  "name": "pigateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Raspberry Pi device gateway: the one process that talks to the ATEM, cameras and AMX",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "atem-connection": "^2.5.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}

{
  "name": "pigateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Raspberry Pi device gateway: the one process that talks to the ATEM, cameras and AMX",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@canva/app-middleware": "0.0.0-beta.8",
    "@jsilvanus/matrox-monarch-control": "^0.6.0",
    "atem-connection": "^2.5.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0"
  },
  "bin": {
    "pigateway": "bin/pigateway.mjs"
  },
  "files": [
    "dist",
    "bin",
    "cli",
    "openapi"
  ],
  "pi": {
    "service": "pigateway",
    "displayName": "PiGateway",
    "layer": "Layer 1: Southbound hardware",
    "port": 3000,
    "ports": {
      "pivoiceUdp": 3101,
      "freedUdp": 40000,
      "amxTcp": 6600
    },
    "healthEndpoint": "/health",
    "envPortVar": "PIGATEWAY_PORT"
  }
}

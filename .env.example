PIGATEWAY_MODE=simulation
PIGATEWAY_HOST=127.0.0.1
PIGATEWAY_PORT=3100
# PIGATEWAY_API_KEY=
# PIGATEWAY_AUTH_ALLOWED_HOSTS=192.168.1.0/24
# PIGATEWAY_CORS_ORIGINS=
# PIGATEWAY_ATEM_HOST=192.168.1.20
# PIGATEWAY_ATEM_PORT=9910
# PIGATEWAY_CAM1_HOST=192.168.1.41
# PIGATEWAY_CAM1_USER=
# PIGATEWAY_CAM1_PASSWORD=
# PIGATEWAY_CAM2_HOST=192.168.1.42
# PIGATEWAY_CAM2_USER=
# PIGATEWAY_CAM2_PASSWORD=
# PIGATEWAY_MEDIAMTX_RTMP_URL=rtmp://192.168.1.78:1935
# PIGATEWAY_MEDIAMTX_RTSP_URL=rtsp://192.168.1.78:8554
# AMX: the master owns the Atlona; the listener is what the AMX connects to (docs/amx-protocol.md in pimatrix)
# PIGATEWAY_AMX_MASTER_HOST=192.168.1.10
# PIGATEWAY_AMX_MASTER_PORT=6501
# PIGATEWAY_AMX_TCP_PORT=6600
# PIGATEWAY_AMX_TCP_HOST=0.0.0.0
# PIGATEWAY_AMX_ALLOWED_HOSTS=192.168.1.10
# Video commands (SOURCE, OUTPUT, QUICK, PROGRAM) are forwarded to pimatrix's own AMX listener
# PIGATEWAY_VIDEO_AMX_HOST=127.0.0.1
# PIGATEWAY_VIDEO_AMX_PORT=6601

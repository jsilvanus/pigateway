[Unit]
Description=PiGateway Device Broker
After=network-online.target mediamtx.service

[Service]
WorkingDirectory=%h/apps/pigateway
EnvironmentFile=%h/apps/pigateway.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node dist/main.js
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
